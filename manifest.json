{
  "manifest_version": 3,
  "name": "OGcode Utils",
  "version": "1.0.0",
  "description": "Set your own default printer, material and nozzle for OGcode (ogcode.dabi.design) instead of starting on Bambu Lab A1 every time.",
  "permissions": ["storage"],
  "host_permissions": ["https://ogcode.dabi.design/*"],
  "content_scripts": [
    {
      "matches": ["https://ogcode.dabi.design/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OGcode Utils",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
